NODE_ENV=development
PORT=3000

# Base de datos - MongoDB
MONGODB_URI=mongodb://localhost:27017/nexogestion

# JWT
JWT_SECRET=tu-clave-secreta-muy-segura-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# Email (para invitaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM=noreply@nexoargentina.app

# Frontend
FRONTEND_URL=http://localhost:5173

# Códigos de activación
ACTIVATION_CODE_EXPIRES=10m
INVITATION_EXPIRES=30d

# Seguridad
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
